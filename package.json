{
  "name": "dsh-pause",
  "version": "0.2.0",
  "description": "DSH 插件：界面左下角一个可拖动的「暂停」按钮。点一下，智能体在下一个步进边界停住，等你把话说完再继续（插话也要等边界，但往往来不及打字）。空闲时按钮自动禁用，再点一次是取消，未兑现的请求会在轮次结束时作废。",
  "author": "deepseek",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pause"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MSSZSD3925/dsh-pause.git"
  },
  "homepage": "https://github.com/MSSZSD3925/dsh-pause#readme",
  "bugs": {
    "url": "https://github.com/MSSZSD3925/dsh-pause/issues"
  }
}
